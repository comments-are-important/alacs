root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = off
trim_trailing_whitespace = true

[GNUmakefile]
indent_style = tab

[*.tindalwic]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = false
max_line_length = off
trim_trailing_whitespace = false

[*.json]
indent_size = 2
